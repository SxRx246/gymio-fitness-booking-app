# Elastic Beanstalk configuration applied during application deployment.
# These settings are versioned with the Docker Compose deployment bundle.

option_settings:
  # Health check endpoint exposed by the API Gateway.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /actuator/health

  # Use a load-balanced Elastic Beanstalk environment.
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced

  # EC2 instance type for running the five Gymio services.
  aws:autoscaling:launchconfiguration:
    InstanceType: c7i-flex.large

  # Keep one EC2 instance for the current deployment.
  # Scaling can be reviewed after addressing in-memory application state.
  aws:autoscaling:asg:
    MinSize: '1'
    MaxSize: '1'
