# Elastic Beanstalk options applied on every deployment.
#
# These live in the source bundle next to Dockerrun.aws.json, so they are
# versioned with the application code and applied by `update-environment`.

option_settings:
  # HTTP health check used by the Elastic Beanstalk load balancer.
  # The gateway must answer this without a JWT - see
  # GatewayAuthFilter.PUBLIC_ENDPOINTS.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /actuator/health

  # Multi-container environments are always load balanced.
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced

  # Five JVMs share one instance: 4 x 512 MB + 1 x 256 MB of container
  # memory plus the ECS agent, so t3.medium (4 GB) is the practical minimum.
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.medium

  # Single instance: PostgreSQL and Kafka are external, so there is nothing
  # to cluster here. Scale out only after moving rate limiting and SSE
  # tracking out of in-memory storage.
  aws:autoscaling:asg:
    MinSize: '1'
    MaxSize: '1'